[Unit]
Description=AgentLink Hub local service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__
Environment=HOME=__RUN_HOME__
Environment=USER=__RUN_USER__
Environment=LOGNAME=__RUN_USER__
Environment=HUB_HOST=__HUB_HOST__
Environment=HUB_PORT=__HUB_PORT__
Environment=HUB_DATA_DIR=__PROJECT_ROOT__/data
Environment=SESSION_WORKDIR_ROOT_RELATIVE=__SESSION_WORKDIR_ROOT_RELATIVE__
Environment=PATH=__RUN_HOME__/.opencode/bin:__RUN_HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__PROJECT_ROOT__/node_modules/.bin/tsx apps/hub/src/server.ts
Restart=always
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
